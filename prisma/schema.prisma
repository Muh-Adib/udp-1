generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// MULTI-BRAND CRM — Company/Contact-centric foundation
// ============================================================

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("MARKETING") // SUPER_ADMIN | DIREKTUR | MARKETING | KEUANGAN | PRODUKSI | CLIENT
  title       String?
  avatarColor String   @default("#10b981")
  isActive    Boolean  @default(true)
  companyId   String?  // khusus role CLIENT — client hanya melihat data company ini
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brandAccess        UserBrandAccess[]
  ownedCompanies     Company[]       @relation("CompanyOwner")
  ownedOpportunities Opportunity[]   @relation("OppOwner")
  assignedTasks      Task[]
  notes              Note[]
  respondedInteractions Interaction[] @relation("Responder")
  managedProjects    Project[]       @relation("ProjectManager")
  auditLogs          AuditLog[]
  createdQuotations  Quotation[]     @relation("QuotationCreator")
  approvedQuotations Quotation[]     @relation("QuotationApprover")
  recordedPayments   Payment[]       @relation("PaymentRecorder")
  preparedBriefs     Brief[]         @relation("BriefPreparer")
  createdEstimations Estimation[]    @relation("EstimationCreator")
  portalComments     PortalComment[] @relation("PortalCommentAuthor")
  clientOfCompany    Company?        @relation("CompanyClients", fields: [companyId], references: [id])
}

model UserBrandAccess {
  id        String  @id @default(cuid())
  userId    String
  brandId   String
  canManage Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
}

model Brand {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  tagline         String?
  description     String?
  color           String  @default("#10b981")
  website         String?
  /* Identitas kontak brand — dipakai di kop dokumen (quotation/invoice) & identifikasi kanal masuk */
  email           String?
  phone           String?
  instagram       String?
  address         String?
  /* Logo brand — dua varian data-URL: persegi 1:1 (avatar/stempel/ikon) & lebar horizontal (kop surat).
     Disimpan sebagai data:image/...;base64 agar tidak butuh file storage terpisah. */
  logoSquare      String?
  logoWide        String?
  primaryCurrency String  @default("IDR")
  invoicePrefix   String  @default("INV")
  quotationPrefix String  @default("QUO")
  slaHours        Int     @default(4)
  workflowType    String  @default("generic") // website | video | animation | livestream | generic
  isActive        Boolean @default(true)

  services    Service[]
  brandAccess UserBrandAccess[]
  sourceOpportunities    Opportunity[] @relation("SourceBrand")
  executingOpportunities Opportunity[] @relation("ExecutingBrand")
  interactions Interaction[]
  projects     Project[]
  templates    FollowUpTemplate[]
  quotations   Quotation[]
  invoices     Invoice[]
}

model Service {
  id          String  @id @default(cuid())
  brandId     String
  name        String
  category    String  @default("Umum")
  description String?
  isActive    Boolean @default(true)

  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
}

model Company {
  id       String   @id @default(cuid())
  name     String
  industry String?
  website  String?
  country  String   @default("Indonesia")
  city     String?
  address  String?
  size     String? // Small | Medium | Enterprise | Government | NGO
  taxId    String?
  currency String   @default("IDR")
  tags     String   @default("") // comma separated
  notes    String?
  ownerId  String?
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User?     @relation("CompanyOwner", fields: [ownerId], references: [id])
  clientUsers   User[]    @relation("CompanyClients")
  contacts      Contact[]
  opportunities Opportunity[]
  interactions  Interaction[]
  projects      Project[]
  quotations    Quotation[]
  invoices      Invoice[]
  portalComments PortalComment[]
}

model Contact {
  id               String  @id @default(cuid())
  companyId        String?
  firstName        String
  lastName         String?
  position         String?
  email            String?
  altEmail         String?
  whatsapp         String?
  phone            String?
  country          String  @default("Indonesia")
  city             String?
  timezone         String  @default("Asia/Jakarta")
  language         String  @default("id") // id | en
  preferredChannel String  @default("WHATSAPP") // WHATSAPP|EMAIL|PHONE|INSTAGRAM|WEBSITE
  linkedin         String?
  consentStatus    String  @default("GRANTED") // GRANTED|PENDING|REVOKED
  tags             String  @default("")
  isPrimary        Boolean @default(false)
  isDeleted        Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id])
  opportunities Opportunity[]
  interactions  Interaction[]
}

model Opportunity {
  id                String    @id @default(cuid())
  code              String    @unique
  title             String
  companyId         String
  contactId         String
  sourceBrandId     String
  executingBrandId  String
  serviceId         String?
  leadSource        String    @default("WEBSITE") // WEBSITE|WHATSAPP|INSTAGRAM|EMAIL|REFERRAL|COLD_CALL|EVENT
  channel           String    @default("WEBSITE") // first inbound channel
  campaign          String?
  brief             String?
  needs             String?
  targetAudience    String?
  deliverables      String?
  deadline          DateTime?
  estimatedValue    Float     @default(0)
  currency          String    @default("IDR")
  probability       Int       @default(20)
  expectedCloseDate DateTime?
  ownerId           String
  priority          String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  stage             String    @default("NEW")
  temperature       String    @default("WARM") // HOT|WARM|COLD
  competitorName    String?
  nextAction        String?
  nextActionDate    DateTime?
  lostReason        String?
  lostNotes         String?
  lastOfferValue    Float?
  reactivation      String? // REOFFER_30|REOFFER_90|BUDGET_PERIOD|CROSS_SELL|SMALLER_PACKAGE|ALTERNATIVE_SERVICE
  followUpDate      DateTime?
  nurtureTrack      String?
  wonAt             DateTime?
  lostAt            DateTime?
  stageUpdatedAt    DateTime  @default(now())
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company    @relation(fields: [companyId], references: [id])
  contact        Contact    @relation(fields: [contactId], references: [id])
  sourceBrand    Brand      @relation("SourceBrand", fields: [sourceBrandId], references: [id])
  executingBrand Brand      @relation("ExecutingBrand", fields: [executingBrandId], references: [id])
  service        Service?   @relation(fields: [serviceId], references: [id])
  owner          User       @relation("OppOwner", fields: [ownerId], references: [id])
  interactions   Interaction[]
  tasks          Task[]
  notes          Note[]
  projects       Project[]
  quotations     Quotation[]
  invoices       Invoice[]
  briefs         Brief[]
  estimations    Estimation[]
}

model Interaction {
  id                String    @id @default(cuid())
  opportunityId     String?
  contactId         String
  companyId         String?
  brandId           String
  channel           String // WHATSAPP|EMAIL|INSTAGRAM|WEBSITE|PHONE|MEETING
  direction         String // IN|OUT
  externalMessageId String?
  subject           String?
  body              String
  attachmentName    String?
  respondedById     String?
  respondedAt       DateTime?
  status            String    @default("DELIVERED") // SENT|DELIVERED|READ
  originalLink      String?
  sentAt            DateTime  @default(now())
  createdAt         DateTime  @default(now())

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  contact     Contact      @relation(fields: [contactId], references: [id])
  company     Company?     @relation(fields: [companyId], references: [id])
  brand       Brand        @relation(fields: [brandId], references: [id])
  responder   User?        @relation("Responder", fields: [respondedById], references: [id])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  opportunityId String?
  assigneeId    String
  dueDate       DateTime?
  status        String    @default("OPEN") // OPEN|IN_PROGRESS|DONE|CANCELLED
  priority      String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  type          String    @default("FOLLOW_UP") // FOLLOW_UP|MEETING|BRIEF|INTERNAL|OTHER
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  assignee    User         @relation(fields: [assigneeId], references: [id])
}

model Note {
  id            String   @id @default(cuid())
  body          String
  opportunityId String
  authorId      String
  visibility    String   @default("INTERNAL") // INTERNAL | DIRECTOR
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  author      User        @relation(fields: [authorId], references: [id])
}

model Project {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique
  opportunityId String    @unique
  companyId     String
  brandId       String
  managerId     String?
  status        String    @default("PLANNING") // PLANNING|IN_PROGRESS|REVIEW|COMPLETED|ON_HOLD
  progress      Int       @default(0)
  workflowType  String    @default("generic")
  budget        Float     @default(0)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  manager     User?       @relation("ProjectManager", fields: [managerId], references: [id])
  milestones  Milestone[]
  invoices    Invoice[]
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  stepOrder   Int       @default(0)
  status      String    @default("PENDING") // PENDING|IN_PROGRESS|DONE
  dueDate     DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model FollowUpTemplate {
  id        String  @id @default(cuid())
  brandId   String
  name      String
  step      Int     @default(1)
  delayDays Int     @default(1)
  channel   String  @default("WHATSAPP") // WHATSAPP|EMAIL|WHATSAPP_EMAIL
  language  String  @default("id") // id | en
  subject   String?
  body      String
  purpose   String?
  isActive  Boolean @default(true)

  brand Brand @relation(fields: [brandId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String // CREATE|UPDATE|DELETE|STAGE_CHANGE|MERGE|LOGIN|LOGOUT|RESTORE
  entityType  String
  entityId    String?
  entityLabel String?
  oldValue    String? // JSON string
  newValue    String? // JSON string
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ============ FASE 2 — Komersial: Quotation, Invoice, Payment ============

model Quotation {
  id                String    @id @default(cuid())
  code              String    @unique
  opportunityId     String
  brandId           String
  companyId         String
  title             String
  status            String    @default("DRAFT") // DRAFT|SENT|ACCEPTED|REJECTED|EXPIRED
  version           Int       @default(1)
  currency          String    @default("IDR")
  subtotal          Float     @default(0)
  discountPct       Float     @default(0)
  discountAmount    Float     @default(0)
  taxPct            Float     @default(11)
  taxAmount         Float     @default(0)
  total             Float     @default(0)
  validUntil        DateTime?
  notes             String?
  discountApprovedById String?
  discountApprovedAt   DateTime?
  sentAt            DateTime?
  decidedAt         DateTime?
  createdById       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items       QuotationItem[]
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  createdBy   User        @relation("QuotationCreator", fields: [createdById], references: [id])
  approvedBy  User?       @relation("QuotationApprover", fields: [discountApprovedById], references: [id])
  invoices    Invoice[]
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  description String
  qty         Float  @default(1)
  unitPrice   Float  @default(0)
  sortOrder   Int    @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String    @id @default(cuid())
  code          String    @unique
  quotationId   String?
  opportunityId String
  projectId     String?
  brandId       String
  companyId     String
  title         String
  status        String    @default("UNPAID") // UNPAID|PARTIAL|PAID|CANCELLED
  currency      String    @default("IDR")
  amount        Float     @default(0)
  taxPct        Float     @default(0)
  total         Float     @default(0)
  paidAmount    Float     @default(0)
  dueDate       DateTime?
  issuedAt      DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  project     Project?    @relation(fields: [projectId], references: [id])
  brand       Brand       @relation(fields: [brandId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  payments    Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Float
  method        String   @default("TRANSFER") // TRANSFER|CASH|QRIS|OTHER
  reference     String?
  paidAt        DateTime @default(now())
  note          String?
  recordedById  String?
  createdAt     DateTime @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentRecorder", fields: [recordedById], references: [id])
}

// ============ FASE 2 — Brief & Estimation (cost breakdown + margin) ============

model Brief {
  id             String    @id @default(cuid())
  opportunityId  String    @unique
  serviceScope   String?
  objectives     String?
  targetAudience String?
  keyMessages    String?
  deliverables   String?
  timeline       String?
  references     String?
  budgetRange    String?
  constraints    String?
  status         String    @default("DRAFT") // DRAFT|FINAL
  preparedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  preparedBy  User?       @relation("BriefPreparer", fields: [preparedById], references: [id])
}

model Estimation {
  id                  String   @id @default(cuid())
  opportunityId       String   @unique
  currency            String   @default("IDR")
  status              String   @default("DRAFT") // DRAFT|FINAL
  internalCost        Float    @default(0) // sum item INTERNAL
  externalCost        Float    @default(0) // sum item non-INTERNAL non-%
  subtotalCost        Float    @default(0)
  contingencyPct      Float    @default(5)
  contingencyAmount   Float    @default(0)
  managementFeePct    Float    @default(10)
  managementFeeAmount Float    @default(0)
  totalCost           Float    @default(0)
  targetMarginPct     Float    @default(30)
  sellingPrice        Float    @default(0) // totalCost / (1 - targetMargin/100)
  taxPct              Float    @default(11)
  taxAmount           Float    @default(0)
  priceWithTax        Float    @default(0)
  notes               String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  items       EstimationItem[]
  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
  createdBy   User?       @relation("EstimationCreator", fields: [createdById], references: [id])
}

model EstimationItem {
  id           String  @id @default(cuid())
  estimationId String
  category     String  // INTERNAL|FREELANCE|EQUIPMENT|TRANSPORT|ACCOMMODATION|TALENT|LOCATION|SOFTWARE|HOSTING|OTHER
  description  String
  qty          Float   @default(1)
  unit         String  @default("unit")
  unitCost     Float   @default(0)
  days         Float?  // durasi (hari) utk labor/equipment — lineTotal = qty × unitCost × days
  sortOrder    Int     @default(0)

  estimation Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)
}

/* R11 — thread diskusi per dokumen portal (quotation/invoice/project) */
model PortalComment {
  id         String   @id @default(cuid())
  entityType String   // QUOTATION | INVOICE | PROJECT
  entityId   String
  companyId  String
  userId     String?
  userName   String
  userRole   String   // snapshot role saat komentar dibuat
  body       String
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation("PortalCommentAuthor", fields: [userId], references: [id])

  @@index([entityType, entityId])
}
