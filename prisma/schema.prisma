generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String // OWNER | MANAGER | MARKETER | FINANCE | CLIENT
  companyId    String? // hanya untuk role CLIENT
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  company  Company? @relation(fields: [companyId], references: [id])
  leads    Lead[]   @relation("AssigneeLeads")
  messages LeadMessage[] @relation("SenderMessages")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  users    User[]
  contacts Contact[]
  leads    Lead[]
  projects Project[]
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  email      String?
  phone      String?
  igUsername String?
  source     String   @default("manual") // kanal pertama kali dikenal: whatsapp | email | instagram | web | manual
  companyId  String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@index([phone])
  @@index([email])
  @@index([igUsername])
}

model Lead {
  id         String   @id @default(cuid())
  code       String   @unique // LD-XXXXXX
  subject    String
  brand      String // unimasi | segia | erfo | unicam
  channel    String // whatsapp | email | instagram | web | manual
  status     String   @default("NEW") // NEW | FOLLOW_UP | QUOTED | WON | LOST (ringkasan, tersinkron dari stage)
  stage      String   @default("NEW") // NEW | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST (tahap funnel)
  estValue   Int      @default(0) // estimasi nilai deal (Rp)
  score      Int      @default(0)
  contactId  String
  companyId  String?
  assigneeId String?
  sourceRef  String? // campaign / halaman web / nomor / alamat email
  lostReason String?
  firstInAt  DateTime? // pesan masuk pertama
  firstOutAt DateTime? // balasan pertama (SLA)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact    Contact     @relation(fields: [contactId], references: [id])
  company    Company?    @relation(fields: [companyId], references: [id])
  assignee   User?       @relation("AssigneeLeads", fields: [assigneeId], references: [id])
  messages   LeadMessage[]
  quotations Quotation[]
  projects   Project[]

  @@index([status])
  @@index([stage])
  @@index([channel])
  @@index([createdAt])
}

model LeadMessage {
  id         String   @id @default(cuid())
  leadId     String
  direction  String // IN | OUT | NOTE
  channel    String // whatsapp | email | instagram | web | internal
  body       String
  externalId String?  @unique // id pesan dari provider (dedupe webhook)
  senderId   String?
  senderName String
  createdAt  DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender User?  @relation("SenderMessages", fields: [senderId], references: [id])

  @@index([leadId])
}

model ChannelConfig {
  id            String    @id @default(cuid())
  type          String    @unique // whatsapp | email | instagram | web
  name          String
  enabled       Boolean   @default(false)
  configJson    String    @default("{}") // kredensial & opsi per kanal (disimpan terenkripsi ringan)
  apiKey        String?   @unique // untuk kanal web & auth webhook
  webhookSecret String? // verifikasi webhook (verify token / signature)
  lastEventAt   DateTime?
  eventCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  role      String? // broadcast ke role (OWNER/MANAGER/MARKETER); null = semua staff
  userId    String? // notifikasi personal
  title     String
  body      String
  type      String   @default("INFO") // NEW_LEAD | SLA | SYSTEM
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorName String
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============ KEUANGAN & PRODUKSI ============

model Quotation {
  id           String    @id @default(cuid())
  number       String    @unique // QT-0001
  leadId       String
  brand        String
  title        String
  itemsJson    String    @default("[]") // [{desc, qty, price}]
  subtotal     Int       @default(0)
  discountPct  Int       @default(0)
  ppnPct       Int       @default(11)
  grandTotal   Int       @default(0)
  status       String    @default("DRAFT") // DRAFT | SENT | APPROVED | REJECTED
  notes        String?
  sentAt       DateTime?
  decidedAt    DateTime?
  decidedNote  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  projects  Project[]

  @@index([status])
  @@index([leadId])
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique // PRJ-0001
  name        String
  brand       String
  companyId   String?
  leadId      String?
  quotationId String?
  status      String    @default("PLANNED") // PLANNED | BRIEFED | IN_PROGRESS | REVIEW | DONE
  progress    Int       @default(0) // 0-100
  budget      Int       @default(0)
  managerName String?
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company?    @relation(fields: [companyId], references: [id])
  lead       Lead?       @relation(fields: [leadId], references: [id])
  quotation  Quotation?  @relation(fields: [quotationId], references: [id])
  milestones Milestone[]
  invoices   Invoice[]

  @@index([status])
  @@index([brand])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  title     String
  orderIdx  Int       @default(0)
  weight    Int       @default(0) // bobot % terhadap progress project
  status    String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  dueDate   DateTime?
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Invoice {
  id          String    @id @default(cuid())
  number      String    @unique // INV-0001
  projectId   String?
  quotationId String?
  leadId      String?
  brand       String
  title       String
  amount      Int       @default(0) // dpp sebelum PPN
  ppnPct      Int       @default(11)
  grandTotal  Int       @default(0)
  dueDate     DateTime?
  status      String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE (OVERDUE dihitung saat baca)
  issuedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project?  @relation(fields: [projectId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])
  payments  Payment[]

  @@index([status])
  @@index([projectId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Int
  method    String   @default("TRANSFER") // TRANSFER | CASH | QRIS | OTHER
  note      String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
